{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["next-env.d.ts", "types/**/*.d.ts", "tests/**/*.ts", "tests/**/*.tsx", "tests/helpers/**/*.cjs"],
  "exclude": ["node_modules", "tests/types"]
}
