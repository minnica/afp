{
  "name": "afp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "icons:generate": "node scripts/generate-icons.mjs",
    "postinstall": "prisma generate",
    "test": "node --import tsx tests/run-tests.ts",
    "db:verify": "prisma generate && node --import tsx scripts/verify-database-reproduction.cjs",
    "db:audit-history": "node scripts/audit-migration-history.cjs",
    "audit:prod": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test:types": "prisma generate && next typegen && tsc --project tsconfig.type-tests.json --noEmit",
    "typecheck:tests": "prisma generate && next typegen && tsc --project tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.90.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.6",
    "shadcn": "^4.22.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
