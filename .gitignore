# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/estados_cuenta
/skills

# Android: compilaciones, configuración local, firmas y muestras privadas
/android/.gradle/
/android/.kotlin/
/android/**/build/
/android/**/__pycache__/
/android/local.properties
/android/signing.properties
/android/.private/
/android/diagnostics/private/
*.jks
*.keystore
*.p12

# Alias bancarios privados, editables por el propietario
/captura-tarjetas.local.json

# Contexto y capturas locales de Impeccable
/.impeccable/
