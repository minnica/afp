generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
  DEBIT
}

enum SubscriptionChargeStatus {
  CONFIRMED
  SKIPPED
}

enum CardCycleStatus {
  OPEN
  CUT
  PAYMENT_PENDING
  PAID
  OVERDUE
}

enum InstallmentPurchaseStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
  ADJUSTED
}

enum ReceivableAccountStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum PayableAccountStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum PayableAccountType {
  SIMPLE
  LOAN
}

enum ReceivableOriginType {
  MANUAL
  DAILY_EXPENSE
  INSTALLMENT_PURCHASE
}

enum PayableOriginType {
  MANUAL
  DAILY_EXPENSE
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())

  cards                Card[]
  cardCycles           CardCycle[]
  cardCycleCredits     CardCycleCredit[]
  categories           Category[]
  people               Person[]
  incomeTypes          IncomeType[]
  dailyExpenses        DailyExpense[]
  expenseOperations    ExpenseOperation[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]
  subscriptionCharges  SubscriptionCharge[]
  incomes              Income[]
  receivableAccounts   ReceivableAccount[]
  payableAccounts      PayableAccount[]
  noticeDismissals     NoticeDismissal[]
  captureDevices       CaptureDevice[]
  captureEvents        CaptureEvent[]
  captureAliases       CaptureCardAlias[]
  captureAutomations   CaptureAutomation[]
  captureBankFallbacks CaptureBankFallback[]
  captureRules         CaptureMerchantRule[]
  captureMovements     CaptureMovement[]
  expenseRefunds       ExpenseRefund[]
  captureStatements    CaptureStatement[]
  expenseTombstones    ExpenseTombstone[]
  googleCalendar       GoogleCalendarConnection?
  calendarOAuthStates  CalendarOAuthState[]

  @@map("users")
  cardCyclePayments CardCyclePayment[]

  capturePaymentPolicies CapturePaymentPolicy[]

  moneyAccounts MoneyAccount[]
  moneyRoutes MoneyRoute[]
  moneyPlans MoneyPlan[]
  moneyTransfers MoneyTransfer[]
  moneyCardPayments MoneyCardPayment[]
  moneyOperations MoneyOperation[]
  moneyWithdrawals MoneyWithdrawal[]
  captureMoneyPolicies CaptureMoneyPolicy[]
  captureMoneyPostings CaptureMoneyPosting[]

}

model GoogleCalendarConnection {
  id                 String   @id @default(uuid())
  userId             String   @unique
  googleSubject      String?
  googleEmail        String?
  refreshToken       String?
  calendarId         String?
  calendarMarker     String   @default(uuid())
  status             String   @default("DISCONNECTED")
  preferences        Json     @default("{}")
  revision           Int      @default(1)
  syncedRevision     Int      @default(0)
  lastSyncedAt       DateTime?
  lastError          String?
  nextAttemptAt      DateTime @default(now())
  attempts           Int      @default(0)
  lockToken          String?
  lockUntil          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events             GoogleCalendarEvent[]

  @@index([status, nextAttemptAt])
  @@map("google_calendar_connections")
}

model CalendarOAuthState {
  stateHash       String   @id
  userId          String
  browserHash     String
  verifier        String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("calendar_oauth_states")
}

model GoogleCalendarEvent {
  connectionId String
  sourceKey    String
  eventId      String
  generation   Int      @default(0)
  eventDate    String
  payloadHash  String?
  removed      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  connection   GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, sourceKey])
  @@unique([connectionId, eventId])
  @@map("google_calendar_events")
}

// Recibo durable: borrar/editar el gasto no permite volver a ejecutar la captura.
model ExpenseOperation {
  userId      String
  operationId String   @db.Uuid
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operationId])
  @@map("expense_operations")
}

model NoticeDismissal {
  id        String   @id @default(uuid())
  userId    String
  month     String
  noticeKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, noticeKey])
  @@index([userId, month])
  @@map("notice_dismissals")
}

model Card {
  id          String   @id @default(uuid())
  userId      String
  name        String
  usualCutDay Int
  usualDueDay Int
  notes       String?
  usagePolicy Json?
  creditLimit Decimal? @db.Decimal(12, 2)
  usedBalance Decimal? @db.Decimal(12, 2)
  balanceAsOf DateTime? @db.Date
  balanceTracking Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycles               CardCycle[]
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]
  captureAliases       CaptureCardAlias[]
  captureAutomations   CaptureAutomation[]
  captureBankFallbacks CaptureBankFallback[]
  captureRules         CaptureMerchantRule[]
  captureStatements    CaptureStatement[]

  @@unique([userId, name])
  @@map("cards")
  capturePaymentPolicies CapturePaymentPolicy[]

}

model CardCycle {
  id              String          @id @default(uuid())
  userId          String
  cardId          String
  month           Int
  year            Int
  startDate       DateTime
  cutDate         DateTime
  dueDate         DateTime
  datesConfirmedAt DateTime?
  statementAmount Decimal?
  status          CardCycleStatus @default(OPEN)
  paidAt          DateTime?
  paidAmount      Decimal?
  postCutCreditAmount Decimal     @default(0)
  postCutCreditDate DateTime?
  postCutCreditNotes String?
  notes           String?
  usageReconciliation Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  credits CardCycleCredit[]

  @@unique([cardId, month, year])
  @@index([userId])
  @@index([cardId])
  @@map("card_cycles")
  payments CardCyclePayment[]
  moneyPayments MoneyCardPayment[]

}

model MoneyAccount {
  id String @id @default(uuid())
  userId String
  name String
  kind String @default("BANK")
  openingBalance Decimal @db.Decimal(12, 2)
  asOf DateTime @db.Date
  baseline Json
  reservedAmount Decimal @default(0) @db.Decimal(12, 2)
  annualYield Decimal @default(0) @db.Decimal(8, 4)
  yieldTaxPercent Decimal @default(0) @db.Decimal(8, 4)
  yieldBasis Int @default(365)
  yieldFrequency String @default("DAILY")
  yieldPayDay Int @default(1)
  yieldCap Decimal? @db.Decimal(12, 2)
  yieldStartDate DateTime? @db.Date
  yieldEndDate DateTime? @db.Date
  yieldIncomeTypeId String?
  autoYield Boolean @default(false)
  yieldMethod String @default("NOMINAL")
  yieldDailyAmount Decimal? @db.Decimal(12, 2)
  yieldExcessRate Decimal @default(0) @db.Decimal(8, 4)
  yieldPayout String @default("DAILY")
  yieldRounding String @default("ROUND")
  yieldInitialPendingDays Int?
  yieldHistory Json @default("[]")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  routes MoneyRoute[]
  plans MoneyPlan[]
  reconciliations MoneyReconciliation[]
  transfersOut MoneyTransfer[] @relation("MoneyTransferOut")
  transfersIn MoneyTransfer[] @relation("MoneyTransferIn")
  payments MoneyCardPayment[]
  debitExpenses DailyExpense[] @relation("DebitAccountExpenses")
  withdrawals MoneyWithdrawal[]
  capturePoliciesFrom CaptureMoneyPolicy[] @relation("CaptureMoneyFrom")
  capturePoliciesTo CaptureMoneyPolicy[] @relation("CaptureMoneyTo")
  @@unique([userId, name])
  @@map("money_accounts")
}

model MoneyReconciliation {
  id String @id @default(uuid())
  accountId String
  date DateTime @db.Date
  previousBalance Decimal @db.Decimal(12, 2)
  bankBalance Decimal @db.Decimal(12, 2)
  reason String
  snapshot Json
  createdAt DateTime @default(now())
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, createdAt])
  @@map("money_reconciliations")
}

model MoneyRoute {
  id String @id @default(uuid())
  userId String
  key String
  accountId String?
  excluded Boolean @default(false)
  planId String?
  occurrenceDate DateTime? @db.Date
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account MoneyAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  plan MoneyPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([userId, key])
  @@map("money_routes")
}

model MoneyPlan {
  id String @id @default(uuid())
  userId String
  name String
  kind String
  amount Decimal @db.Decimal(12, 2)
  accountId String
  cardId String?
  incomeTypeId String?
  categoryId String?
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  frequencyMonths Int @default(1)
  days Int[] @default([])
  payrollBusinessDays Boolean @default(false)
  paymentMix Json?
  isActive Boolean @default(true)
  version Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  matches MoneyRoute[]
  occurrences MoneyOccurrence[]
  @@index([userId])
  @@map("money_plans")
}

model MoneyOccurrence {
  id String @id @default(uuid())
  planId String
  date DateTime @db.Date
  status String
  plan MoneyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, date])
  @@map("money_occurrences")
}

model MoneyTransfer {
  id String @id @default(uuid())
  userId String
  fromAccountId String
  toAccountId String
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  concept String
  reversedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount MoneyAccount @relation("MoneyTransferOut", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount MoneyAccount @relation("MoneyTransferIn", fields: [toAccountId], references: [id], onDelete: Restrict)
  capturePostings CaptureMoneyPosting[]
  @@index([userId, date])
  @@map("money_transfers")
}

model MoneyCardPayment {
  id String @id @default(uuid())
  userId String
  cycleId String
  accountId String
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  reversedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle CardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  capturePostings CaptureMoneyPosting[]
  @@index([userId, cycleId])
  @@map("money_card_payments")
}

model MoneyOperation {
  userId String
  operationId String @db.Uuid
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, operationId])
  @@map("money_operations")
}

model CardCycleCredit {
  id          String   @id @default(uuid())
  userId      String
  cycleId     String
  incomeId    String
  amount      Decimal
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle  CardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  income Income    @relation(fields: [incomeId], references: [id], onDelete: Restrict)

  @@unique([cycleId, incomeId])
  @@index([userId])
  @@index([incomeId])
  @@map("card_cycle_credits")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]

  @@unique([userId, name])
  @@map("categories")
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  name      String
  notes     String?
  createdAt DateTime @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  receivableAccounts   ReceivableAccount[]
  payableAccounts      PayableAccount[]

  @@unique([userId, name])
  @@map("people")
}

model IncomeType {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes Income[]

  @@unique([userId, name])
  @@map("income_types")
}

model DailyExpense {
  id                      String        @id @default(uuid())
  userId                  String
  date                    DateTime
  paymentMethod           PaymentMethod
  cardId                  String?
  debitAccountId          String?
  concept                 String
  amount                  Decimal
  refundOriginalAmount    Decimal?
  cashContributionAmount  Decimal       @default(0)
  categoryId              String
  notes                   String?
  personId                String?
  receivableAccountId     String?
  payableAccountId        String?
  subscriptionId          String?
  reconciliationStatus    String        @default("CONFIRMED")
  reconciledAt            DateTime?
  loanBalanceAfterPayment Decimal?
  loanInterestAmount      Decimal?
  loanPrincipalAmount     Decimal?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  card               Card?               @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category           Category            @relation(fields: [categoryId], references: [id])
  person             Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  receivableAccount  ReceivableAccount?  @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  payableAccount     PayableAccount?     @relation(fields: [payableAccountId], references: [id], onDelete: SetNull)
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionCharge SubscriptionCharge?
  debitAccount       MoneyAccount? @relation("DebitAccountExpenses", fields: [debitAccountId], references: [id], onDelete: Restrict)
  moneyCapturePostings CaptureMoneyPosting[]
  captureMovements   CaptureMovement[]
  refunds            ExpenseRefund[]

  @@index([userId, date])
  @@index([cardId])
  @@index([categoryId])
  @@index([payableAccountId])
  @@index([subscriptionId])
  @@map("daily_expenses")
}

model InstallmentPurchase {
  id                       String                    @id @default(uuid())
  userId                   String
  cardId                   String
  purchaseDate             DateTime
  concept                  String
  totalAmount              Decimal
  months                   Int
  manualMonthlyPayment     Decimal?
  statementReconciliations Json?
  initialPaymentsMade      Int                       @default(0)
  personId                 String?
  receivableAccountId      String?
  categoryId               String
  notes                    String?
  status                   InstallmentPurchaseStatus @default(ACTIVE)
  reconciliationStatus     String                    @default("CONFIRMED")
  reconciledAt             DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              Card               @relation(fields: [cardId], references: [id])
  person            Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  receivableAccount ReceivableAccount? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  category          Category           @relation(fields: [categoryId], references: [id])
  captureMovements  CaptureMovement[]

  @@index([userId, purchaseDate])
  @@index([cardId])
  @@index([categoryId])
  @@map("installment_purchases")
}

model Subscription {
  id              String        @id @default(uuid())
  userId          String
  name            String
  amount          Decimal
  paymentMethod   PaymentMethod
  cardId          String?
  categoryId      String
  chargeDay       Int
  frequencyMonths Int           @default(1)
  startMonth      Int           @default(1)
  startYear       Int           @default(2026)
  isActive        Boolean       @default(true)
  deactivatedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?                @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category      Category             @relation(fields: [categoryId], references: [id])
  dailyExpenses DailyExpense[]
  charges       SubscriptionCharge[]
  capturePolicies CaptureAutomation[]

  @@index([userId])
  @@index([cardId])
  @@index([categoryId])
  @@map("subscriptions")
}

model SubscriptionCharge {
  id             String                   @id @default(uuid())
  userId         String
  subscriptionId String
  month          String
  status         SubscriptionChargeStatus
  expenseId      String?                  @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  expense      DailyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, month])
  @@index([userId, month])
  @@map("subscription_charges")
}

model ReceivableAccount {
  id                     String                  @id @default(uuid())
  userId                 String
  personId               String
  concept                String
  originalAmount         Decimal
  // Conciliación no monetaria: conserva principal e ingresos reales.
  balanceAdjustment      Decimal                 @default(0)
  balanceAdjustmentNotes String?
  originDate             DateTime
  expectedMonthlyPayment Decimal?
  expectedChargeDays     Int[]                   @default([])
  notes                  String?
  status                 ReceivableAccountStatus @default(ACTIVE)
  originType             ReceivableOriginType
  originId               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  person               Person                @relation(fields: [personId], references: [id])
  incomes              Income[]
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  reimbursedPayables   PayableAccount[]

  @@index([userId])
  @@index([personId])
  @@map("receivable_accounts")
}

model PayableAccount {
  id                     String               @id @default(uuid())
  userId                 String
  personId               String
  concept                String
  originalAmount         Decimal
  originDate             DateTime
  expectedMonthlyPayment Decimal?
  expectedDate           DateTime?
  notes                  String?
  status                 PayableAccountStatus @default(ACTIVE)
  originType             PayableOriginType
  originId               String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  // Campos históricos de préstamos; conservan el contrato ya aplicado en la BD.
  accountType               PayableAccountType @default(SIMPLE)
  annualInterestRate        Decimal?
  currentBalance            Decimal?
  firstPaymentDate          DateTime?
  paymentAmount             Decimal?
  paymentDays               Int[]              @default([])
  paymentsMade              Int?
  reimbursementReceivableId String?
  totalPayments             Int?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  person        Person         @relation(fields: [personId], references: [id])
  dailyExpenses DailyExpense[]

  reimbursementReceivable ReceivableAccount? @relation(fields: [reimbursementReceivableId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([personId])
  @@index([reimbursementReceivableId])
  @@map("payable_accounts")
}

model Income {
  id                  String   @id @default(uuid())
  userId              String
  date                DateTime
  incomeTypeId        String
  source              String
  concept             String
  amount              Decimal
  receivableAccountId String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeType        IncomeType         @relation(fields: [incomeTypeId], references: [id])
  receivableAccount ReceivableAccount? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  cardCycleCredits  CardCycleCredit[]

  @@index([userId, date])
  @@index([incomeTypeId])
  @@index([receivableAccountId])
  @@map("incomes")
}

// Una identidad se autoriza una sola vez; nunca se reasigna a otra cuenta.
model CaptureDevice {
  id         String          @id @default(uuid()) @db.Uuid
  secretHash String          @unique
  name       String
  userId     String?
  createdAt  DateTime        @default(now())
  approvedAt DateTime?
  pausedAt   DateTime?
  revokedAt  DateTime?
  lastSeenAt DateTime?
  pausedPackages Json @default("[]")
  reportedState Json?
  reportedAt DateTime?
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pairing    CapturePairing?
  events     CaptureEvent[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("capture_devices")
}

model CapturePairing {
  id         String        @id @default(uuid()) @db.Uuid
  deviceId   String        @unique @db.Uuid
  codeHash   String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  device     CaptureDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("capture_pairings")
}

model CaptureEvent {
  id                  String           @id @default(uuid()) @db.Uuid
  deviceId            String           @db.Uuid
  userId              String
  eventId             String           @db.Uuid
  contractVersion     Int
  sourcePackage       String
  notificationKeyHash String
  postedAt            DateTime
  receivedAt          DateTime
  fields              Json
  requestHash         String
  createdAt           DateTime         @default(now())
  interpretation      Json?
  movementId          String?          @db.Uuid
  movement            CaptureMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  device              CaptureDevice    @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([deviceId, eventId])
  @@index([userId, createdAt])
  @@index([deviceId, sourcePackage, notificationKeyHash, postedAt])
  @@map("capture_events")
}

// El alias pertenece a una tarjeta concreta. Se permiten colisiones entre tarjetas:
// el resolver las detecta y bloquea la automatización, nunca elige la primera.
model CaptureCardAlias {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String
  cardId        String
  sourcePackage String
  kind          String
  value         String
  verifiedAt    DateTime?
  evidence      String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, sourcePackage, kind, value])
  @@index([userId, sourcePackage, kind, value])
  @@map("capture_card_aliases")
}

model CaptureAutomation {
  id        String @id @default(uuid()) @db.Uuid
  userId    String
  cardId    String
  parserKey String
  mode      String @default("OBSERVATION")
  datePolicy String @default("BANK_OPERATION")
  completionPolicy String?
  policyAcceptedAt DateTime?
  policySubscriptionId String?
  policySubscription Subscription? @relation(fields: [policySubscriptionId], references: [id], onDelete: SetNull)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, parserKey])
  @@unique([userId, parserKey, completionPolicy], map: "capture_automations_owner_format_policy_key")
  @@map("capture_automations")
}

model CaptureMerchantRule {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String
  cardId         String
  merchant       String
  categoryId     String
  subscriptionId String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, merchant])
  @@map("capture_merchant_rules")
}

// Respaldo bancario aceptado por tarjeta. Publicar no activa reglas ni gastos.
model CaptureBankFallback {
  id String @id @default(uuid()) @db.Uuid
  userId String
  cardId String
  bankSourcePackage String
  mode String @default("OBSERVATION")
  currency String @default("MXN")
  bankDatePolicy String
  purchasesOnly Boolean
  waitMinutes Int @default(15)
  acceptedAt DateTime
  evidenceMovementId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  evidence CaptureMovement @relation(fields: [evidenceMovementId], references: [id], onDelete: Restrict)

  @@unique([userId, cardId])
  @@map("capture_bank_fallbacks")
}

// El análisis inicial (en el evento), el historial solicitado y originalExpenseId
// sobreviven a ediciones/borrados. proposal contiene el análisis vigente.
// No se vuelve a interpretar automáticamente un evento ya recibido.
model CaptureMovement {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String
  status                String               @default("REVIEW")
  reason                String
  parserKey             String?
  proposal              Json
  correction            Json?
  analysisHistory       Json?
  cardId                String?
  amount                Decimal?
  operationDate         DateTime?
  referenceKey          String?
  expenseId             String?
  originalExpenseId     String?
  installmentPurchaseId String?
  createdAt             DateTime             @default(now())
  resolvedAt            DateTime?
  fallbackDueAt         DateTime?
  fallbackEvidenceFor   CaptureBankFallback[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense               DailyExpense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: SetNull)
  events                CaptureEvent[]

  @@unique([userId, referenceKey])
  @@index([userId, status, createdAt])
  @@index([userId, cardId, operationDate])
  @@index([fallbackDueAt])
  @@map("capture_movements")
  cardPayment CardCyclePayment?
  refund ExpenseRefund?
  moneyPosting CaptureMoneyPosting?

}

// El gasto conserva su identidad; amount es el neto y el cargo original queda
// aquí y en refundOriginalAmount. Borrar el gasto no borra la evidencia.
model ExpenseRefund {
  id                String @id @default(uuid()) @db.Uuid
  userId            String
  expenseId         String?
  originalExpenseId String
  movementId        String @unique @db.Uuid
  amount            Decimal @db.Decimal(12, 2)
  date              DateTime @db.Date
  expenseSnapshot   Json
  createdAt         DateTime @default(now())
  reversedAt        DateTime?
  movement          CaptureMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  expense           DailyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, originalExpenseId])
  @@map("expense_refunds")
}

model ExpenseTombstone {
  expenseId String   @id
  userId    String
  cardId    String?
  date      DateTime
  amount    Decimal
  concept   String
  deletedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, cardId, date])
  @@map("expense_tombstones")
}

// Ventanas persistentes: los límites no dependen de la memoria de una función.
// Cotejo manual de cargos de un período; las huellas conservan el historial
// incluso si el usuario modifica o elimina posteriormente un registro.
model CaptureStatement {
  id String @id @default(uuid()) @db.Uuid
  userId String
  cardId String
  startDate String
  endDate String
  chargesTotal Decimal?
  notes String @default("")
  matches Json @default("{}")
  operations Json @default("{}")
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, startDate, endDate])
  @@map("capture_statements")
}

model CaptureRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("capture_rate_limits")
}

// Abonos capturados y evidencia de importes ya incluidos en el acumulado.
// Los pagos manuales históricos conservan exactamente sus campos existentes.
model CardCyclePayment {
  id String @id @default(uuid()) @db.Uuid
  userId String
  cycleId String
  movementId String @unique @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  kind String
  reversedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle CardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  movement CaptureMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([userId, cycleId])
  @@map("card_cycle_payments")
}

model CapturePaymentPolicy {
  id String @id @default(uuid()) @db.Uuid
  userId String
  cardId String
  source String
  destinationLast4 String?
  destinationHash String?
  mode String @default("OBSERVATION")
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, source])
  @@unique([userId, source, destinationLast4])
  @@map("capture_payment_policies")
}

// Salida de una cuenta que no representa una compra ni un pago de crédito.
model MoneyWithdrawal {
  id String @id @default(uuid())
  userId String
  accountId String
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  concept String
  reversedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  capturePostings CaptureMoneyPosting[]
  @@index([userId, date])
  @@map("money_withdrawals")
}

model CaptureMoneyPolicy {
  id String @id @default(uuid())
  userId String
  kind String
  mode String @default("OBSERVATION")
  fromAccountId String
  toAccountId String?
  destinationLabel String @default("")
  accountLast4 String?
  accountSuffixes String[] @default([])
  currency String @default("MXN")
  datePolicy String @default("NOTIFICATION_POSTED_AT")
  acceptedAt DateTime
  verifiedMovementId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount MoneyAccount @relation("CaptureMoneyFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount MoneyAccount? @relation("CaptureMoneyTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  @@unique([userId, kind, destinationLabel])
  @@map("capture_money_policies")
}

// Una decisión financiera por aviso. No se pierde al borrar el gasto vinculado.
model CaptureMoneyPosting {
  id String @id @default(uuid()) @db.Uuid
  userId String
  movementId String @unique @db.Uuid
  sourceKey String
  kind String
  transferId String?
  withdrawalId String?
  expenseId String?
  cardPaymentId String?
  originalRecordId String
  snapshot Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement CaptureMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  transfer MoneyTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  withdrawal MoneyWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  cardPayment MoneyCardPayment? @relation(fields: [cardPaymentId], references: [id], onDelete: SetNull)
  expense DailyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  @@unique([userId, sourceKey])
  @@map("capture_money_postings")
}
