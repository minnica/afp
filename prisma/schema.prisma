generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
}

enum SubscriptionChargeStatus {
  CONFIRMED
  SKIPPED
}

enum CardCycleStatus {
  OPEN
  CUT
  PAYMENT_PENDING
  PAID
  OVERDUE
}

enum InstallmentPurchaseStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
  ADJUSTED
}

enum ReceivableAccountStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum PayableAccountStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum PayableAccountType {
  SIMPLE
  LOAN
}

enum ReceivableOriginType {
  MANUAL
  DAILY_EXPENSE
  INSTALLMENT_PURCHASE
}

enum PayableOriginType {
  MANUAL
  DAILY_EXPENSE
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())

  cards                Card[]
  cardCycles           CardCycle[]
  cardCycleCredits     CardCycleCredit[]
  categories           Category[]
  people               Person[]
  incomeTypes          IncomeType[]
  dailyExpenses        DailyExpense[]
  expenseOperations    ExpenseOperation[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]
  subscriptionCharges  SubscriptionCharge[]
  incomes              Income[]
  receivableAccounts   ReceivableAccount[]
  payableAccounts      PayableAccount[]
  noticeDismissals     NoticeDismissal[]

  @@map("users")
}

// Recibo durable: borrar/editar el gasto no permite volver a ejecutar la captura.
model ExpenseOperation {
  userId      String
  operationId String   @db.Uuid
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operationId])
  @@map("expense_operations")
}

model NoticeDismissal {
  id        String   @id @default(uuid())
  userId    String
  month     String
  noticeKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, noticeKey])
  @@index([userId, month])
  @@map("notice_dismissals")
}

model Card {
  id          String   @id @default(uuid())
  userId      String
  name        String
  usualCutDay Int
  usualDueDay Int
  notes       String?
  usagePolicy Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycles               CardCycle[]
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]

  @@unique([userId, name])
  @@map("cards")
}

model CardCycle {
  id              String          @id @default(uuid())
  userId          String
  cardId          String
  month           Int
  year            Int
  startDate       DateTime
  cutDate         DateTime
  dueDate         DateTime
  statementAmount Decimal?
  status          CardCycleStatus @default(OPEN)
  paidAt          DateTime?
  paidAmount      Decimal?
  notes           String?
  usageReconciliation Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  credits CardCycleCredit[]

  @@unique([cardId, month, year])
  @@index([userId])
  @@index([cardId])
  @@map("card_cycles")
}

model CardCycleCredit {
  id          String   @id @default(uuid())
  userId      String
  cycleId     String
  incomeId    String
  amount      Decimal
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle  CardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  income Income    @relation(fields: [incomeId], references: [id], onDelete: Restrict)

  @@unique([cycleId, incomeId])
  @@index([userId])
  @@index([incomeId])
  @@map("card_cycle_credits")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  subscriptions        Subscription[]

  @@unique([userId, name])
  @@map("categories")
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  name      String
  notes     String?
  createdAt DateTime @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  receivableAccounts   ReceivableAccount[]
  payableAccounts      PayableAccount[]

  @@unique([userId, name])
  @@map("people")
}

model IncomeType {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes Income[]

  @@unique([userId, name])
  @@map("income_types")
}

model DailyExpense {
  id                  String        @id @default(uuid())
  userId              String
  date                DateTime
  paymentMethod       PaymentMethod
  cardId              String?
  concept             String
  amount              Decimal
  categoryId          String
  notes               String?
  personId            String?
  receivableAccountId String?
  payableAccountId    String?
  subscriptionId      String?
  loanBalanceAfterPayment Decimal?
  loanInterestAmount      Decimal?
  loanPrincipalAmount     Decimal?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              Card?              @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category          Category           @relation(fields: [categoryId], references: [id])
  person            Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  receivableAccount ReceivableAccount? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  payableAccount    PayableAccount?    @relation(fields: [payableAccountId], references: [id], onDelete: SetNull)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionCharge SubscriptionCharge?

  @@index([userId, date])
  @@index([cardId])
  @@index([categoryId])
  @@index([payableAccountId])
  @@index([subscriptionId])
  @@map("daily_expenses")
}

model InstallmentPurchase {
  id                   String                    @id @default(uuid())
  userId               String
  cardId               String
  purchaseDate         DateTime
  concept              String
  totalAmount          Decimal
  months               Int
  manualMonthlyPayment Decimal?
  statementReconciliations Json?
  initialPaymentsMade  Int                       @default(0)
  personId             String?
  receivableAccountId  String?
  categoryId           String
  notes                String?
  status               InstallmentPurchaseStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              Card               @relation(fields: [cardId], references: [id])
  person            Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  receivableAccount ReceivableAccount? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  category          Category           @relation(fields: [categoryId], references: [id])

  @@index([userId, purchaseDate])
  @@index([cardId])
  @@index([categoryId])
  @@map("installment_purchases")
}

model Subscription {
  id              String        @id @default(uuid())
  userId          String
  name            String
  amount          Decimal
  paymentMethod   PaymentMethod
  cardId          String?
  categoryId      String
  chargeDay       Int
  frequencyMonths Int           @default(1)
  startMonth      Int           @default(1)
  startYear       Int           @default(2026)
  isActive        Boolean       @default(true)
  deactivatedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id])
  dailyExpenses DailyExpense[]
  charges       SubscriptionCharge[]

  @@index([userId])
  @@index([cardId])
  @@index([categoryId])
  @@map("subscriptions")
}

model SubscriptionCharge {
  id             String                   @id @default(uuid())
  userId         String
  subscriptionId String
  month          String
  status         SubscriptionChargeStatus
  expenseId      String?                  @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  expense      DailyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, month])
  @@index([userId, month])
  @@map("subscription_charges")
}

model ReceivableAccount {
  id                     String                  @id @default(uuid())
  userId                 String
  personId               String
  concept                String
  originalAmount         Decimal
  originDate             DateTime
  expectedMonthlyPayment Decimal?
  expectedChargeDays     Int[]                   @default([])
  notes                  String?
  status                 ReceivableAccountStatus @default(ACTIVE)
  originType             ReceivableOriginType
  originId               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  person               Person                @relation(fields: [personId], references: [id])
  incomes              Income[]
  dailyExpenses        DailyExpense[]
  installmentPurchases InstallmentPurchase[]
  reimbursedPayables   PayableAccount[]

  @@index([userId])
  @@index([personId])
  @@map("receivable_accounts")
}

model PayableAccount {
  id                     String               @id @default(uuid())
  userId                 String
  personId               String
  concept                String
  originalAmount         Decimal
  originDate             DateTime
  expectedMonthlyPayment Decimal?
  expectedDate           DateTime?
  notes                  String?
  status                 PayableAccountStatus @default(ACTIVE)
  originType             PayableOriginType
  originId               String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  // Campos históricos de préstamos; conservan el contrato ya aplicado en la BD.
  accountType               PayableAccountType @default(SIMPLE)
  annualInterestRate        Decimal?
  currentBalance            Decimal?
  firstPaymentDate          DateTime?
  paymentAmount             Decimal?
  paymentDays               Int[]              @default([])
  paymentsMade              Int?
  reimbursementReceivableId String?
  totalPayments             Int?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  person        Person         @relation(fields: [personId], references: [id])
  dailyExpenses DailyExpense[]

  reimbursementReceivable ReceivableAccount? @relation(fields: [reimbursementReceivableId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([personId])
  @@index([reimbursementReceivableId])
  @@map("payable_accounts")
}

model Income {
  id                  String   @id @default(uuid())
  userId              String
  date                DateTime
  incomeTypeId        String
  source              String
  concept             String
  amount              Decimal
  receivableAccountId String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeType        IncomeType         @relation(fields: [incomeTypeId], references: [id])
  receivableAccount ReceivableAccount? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)
  cardCycleCredits  CardCycleCredit[]

  @@index([userId, date])
  @@index([incomeTypeId])
  @@index([receivableAccountId])
  @@map("incomes")
}
